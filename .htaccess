Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laravel must only be served through its public directory.
    RewriteCond %{HTTP_HOST} ^localhost(?::\d+)?$ [NC]
    RewriteRule ^$ /mmaci-library-portal/public/ [R=302,L]

    # Block application internals if this repository sits under a web root.
    RewriteRule ^(?:app|bootstrap|config|database|node_modules|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]

    # Block project, environment, dependency, and private documentation files.
    RewriteRule ^(?:\.env(?:\..*)?|\.git(?:/|$)|\.vscode(?:/|$)|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js|README\.md|MMACI_.*\.docx)$ - [F,L,NC]
    RewriteRule ^(?:admin_manual_render|public_manual_render)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>
